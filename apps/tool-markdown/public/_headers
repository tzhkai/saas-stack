# Fingerprinted Astro build assets are content-addressed and safe to cache for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Fingerprinted font assets may be cached for a year. Root image names are not content-addressed.
/*.woff2
  Cache-Control: public, max-age=31536000, immutable

# The social sharing images have stable root URLs, so they must be revalidated when replaced.
/og-image.png
  Cache-Control: no-cache
/og-image.svg
  Cache-Control: no-cache

# Root scripts are not content-addressed. Revalidate so updated privacy, editor, and consent behavior reaches visitors promptly.
/analytics-consent.js
  Cache-Control: no-cache
/editor.js
  Cache-Control: no-cache
/editor.v2.js
  Cache-Control: no-cache

# Raw HTML exports are not canonical content pages and must not be indexed.
/*.html
  Cache-Control: public, max-age=3600, must-revalidate
  X-Robots-Tag: noindex

# HTML documents, crawlers' discovery files, and the editor route should always revalidate.
/editor/*
  Cache-Control: no-cache
/robots.txt
  Cache-Control: no-cache
/sitemap-index.xml
  Cache-Control: no-cache
/sitemap-*.xml
  Cache-Control: no-cache
