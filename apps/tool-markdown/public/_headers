# Cache static assets for 1 year (fingerprinted or immutable)
/js/*
  Cache-Control: public, max-age=31536000, immutable

/css/*
  Cache-Control: public, max-age=31536000, immutable

/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable

# Images and fonts
/*.png
  Cache-Control: public, max-age=31536000, immutable
/*.svg
  Cache-Control: public, max-age=31536000, immutable
/*.woff2
  Cache-Control: public, max-age=31536000, immutable

# HTML pages — short cache, revalidate
/*.html
  Cache-Control: public, max-age=3600, must-revalidate
  X-Robots-Tag: noindex

# The standalone editor changes more often than its fingerprinted assets.
# Revalidate its route so new safety/privacy scripts are not delayed by edge HTML caching.
/editor/*
  Cache-Control: no-cache
