---
export interface Props {
  title: string;
  description: string;
  canonical?: string;
  jsonld?: Record<string, any>;
  robots?: string;
}

const { title, description, canonical, jsonld, robots = 'index, follow' } = Astro.props;
const ogImage = 'https://markdownmaster.site/og-image.png';

// Google Analytics 4 - set your Measurement ID (e.g. 'G-XXXXXXXXXX') after creating GA4 property
const GA_MEASUREMENT_ID = 'G-C9YBSZ3YDN';
// Google Search Console - set verification code after verifying domain ownership
// To get your code: Google Search Console → Add Property → Choose "HTML tag" → Copy the content value
const GOOGLE_SITE_VERIFICATION = ''; // e.g. 'your_verification_code_here'

---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content={robots} />
  {canonical && <link rel="canonical" href={canonical} />}

  {GOOGLE_SITE_VERIFICATION && <meta name="google-site-verification" content={GOOGLE_SITE_VERIFICATION} />}


  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:site_name" content="MarkdownMaster" />
  <meta property="og:url" content={canonical || 'https://markdownmaster.site'} />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)}></script>}

  <link rel="alternate" type="application/rss+xml" title="MarkdownMaster Blog" href="https://markdownmaster.site/feed.xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />

  <style>
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
    :root {
      --bg: #0f172a; --bg-card: #1e293b; --bg-card-alt: #1e293b;
      --text: #e2e8f0; --text-dim: #94a3b8; --text-muted: #64748b;
      --border: #334155; --accent: #0ea5e9; --accent-hover: #38bdf8;
      --font: 'Inter', sans-serif; --font-mono: 'JetBrains Mono', monospace;
    }
    html { scroll-behavior: smooth; }
    body {
      font-family: var(--font); background: var(--bg); color: var(--text);
      line-height: 1.6; min-height: 100vh;
      display: flex; flex-direction: column;
    }
    .site-header {
      background: var(--bg-card); border-bottom: 1px solid var(--border);
      padding: 0.75rem 1.5rem; display: flex;
      align-items: center; justify-content: space-between;
      flex-shrink: 0;
    }
    .site-logo {
      font-size: 1.25rem; font-weight: 700; color: var(--accent);
      text-decoration: none; display: flex; align-items: center; gap: 0.5rem;
    }
    .site-nav { display: flex; align-items: center; gap: 0.25rem; }
    .site-nav a {
      text-decoration: none; color: var(--text-dim);
      padding: 0.4rem 0.75rem; border-radius: 6px; font-size: 0.9rem;
      font-weight: 500; transition: all 0.15s;
    }
    .site-nav a:hover { color: var(--accent); background: rgba(14,165,233,0.08); }
    .site-main { flex: 1; display: flex; flex-direction: column; }
    .site-footer {
      flex-shrink: 0; text-align: center; padding: 1.5rem;
      color: var(--text-muted); font-size: 0.85rem;
      border-top: 1px solid var(--border);
    }
    .site-footer a { color: var(--text-dim); text-decoration: none; margin: 0 0.5rem; }
    .site-footer a:hover { color: var(--accent); }
    @media (max-width: 640px) {
      .site-header { padding: 0.65rem 0.75rem; gap: 0.35rem; align-items: flex-start; }
      .site-logo { font-size: 1rem; white-space: nowrap; }
      .site-nav { flex-wrap: wrap; justify-content: flex-end; gap: 0.1rem; }
      .site-nav a { padding: 0.35rem 0.45rem; font-size: 0.8rem; }
    }
  </style>
</head>
<body>
  <header class="site-header">
    <a href="/" class="site-logo">&#x1F4DD; MarkdownMaster</a>
    <nav class="site-nav">
      <a href="/editor/">Editor</a>
      <a href="/docs/">Docs</a>
      <a href="/tools/">Tools</a>
      <a href="/templates/">Templates</a>
      <a href="/blog/">Blog</a>
    </nav>
  </header>
  <main class="site-main">
    <slot />
  </main>
  <footer class="site-footer">
    <p>&copy; 2026 MarkdownMaster &middot;
      <a href="/about/">About</a> &middot;
      <a href="/privacy/">Privacy</a> &middot;
      <a href="/terms/">Terms</a> &middot;
      <a href="https://github.com/tzhkai/markdownmaster" target="_blank" rel="noopener">GitHub</a>
    </p>
    <p style="margin-top:0.3rem;font-size:0.8rem;">Built by <a href="https://knexio.xyz" target="_blank" rel="noopener">Knexio</a> &middot; Open source Markdown editor</p>
  </footer>

  <!-- Optional analytics consent: Markdown content is never passed to analytics. -->
  <div id="cookie-banner" role="dialog" aria-live="polite" aria-label="Optional analytics preference" style="display:none;position:fixed;bottom:0;left:0;right:0;background:#1e293b;border-top:1px solid #334155;padding:14px 20px;z-index:10000;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;font-size:0.85rem;color:#e2e8f0;">
    <span>Optional analytics help us improve the site. Analytics stays off until you choose Allow, and your Markdown text is never sent to analytics. <a href="/privacy/" style="color:#0ea5e9;">Privacy details</a></span>
    <span style="display:flex;gap:8px;flex-wrap:wrap;">
      <button id="cookie-decline" style="background:transparent;color:#e2e8f0;border:1px solid #64748b;padding:8px 14px;border-radius:6px;cursor:pointer;font-weight:600;font-size:0.85rem;white-space:nowrap;">No analytics</button>
      <button id="cookie-accept" style="background:#0ea5e9;color:#fff;border:none;padding:8px 18px;border-radius:6px;cursor:pointer;font-weight:600;font-size:0.85rem;white-space:nowrap;">Allow analytics</button>
    </span>
  </div>
  <script is:inline define:vars={{ GA_MEASUREMENT_ID }}>window.MM_ANALYTICS_ID = GA_MEASUREMENT_ID;</script>
  <script is:inline src="/analytics-consent.js?v=1"></script>
</body>
</html>
