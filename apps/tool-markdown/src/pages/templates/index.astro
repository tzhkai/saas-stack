---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { MARKDOWN_TEMPLATES } from '../../data/templates';

const canonical = 'https://markdownmaster.site/templates/';
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: 'Free Markdown Templates',
      description: 'Free copy-ready Markdown templates for GitHub READMEs, API docs, command references, comparison tables, release notes, and technical briefs.',
      isPartOf: { '@id': 'https://markdownmaster.site/#website' },
    },
    {
      '@type': 'ItemList',
      name: 'Markdown templates',
      itemListElement: MARKDOWN_TEMPLATES.map((template, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: template.title,
        url: `https://markdownmaster.site/templates/${template.slug}/`,
      })),
    },
  ],
};
---

<BaseLayout
  title="Free Markdown Templates for README, API Docs & Release Notes | MarkdownMaster"
  description="Copy free Markdown templates for GitHub READMEs, API documentation, CLI references, comparison tables, release notes, and technical briefs. No sign-up required."
  canonical={canonical}
  jsonld={jsonld}
>
  <style>
    .templates-page { width:min(100% - 2rem, 1120px); margin:0 auto; padding:3.25rem 0 4.5rem; }
    .templates-hero { max-width:800px; margin:0 auto; text-align:center; }
    .eyebrow { display:inline-flex; padding:.3rem .65rem; border:1px solid rgba(14,165,233,.4); border-radius:999px; color:var(--accent); font-size:.78rem; font-weight:700; letter-spacing:.05em; text-transform:uppercase; }
    h1,h2,h3 { letter-spacing:-.028em; }
    h1 { margin:.75rem 0 1rem; font-size:clamp(2.35rem,6vw,4.4rem); line-height:1.04; }
    .templates-hero > p:not(.eyebrow) { max-width:700px; margin:0 auto; color:var(--text-dim); font-size:1.08rem; line-height:1.75; }
    .trust-strip { display:flex; justify-content:center; flex-wrap:wrap; gap:.55rem 1.25rem; margin:1.5rem 0 0; color:var(--text-muted); font-size:.88rem; }
    .trust-strip span::before { content:'✓'; margin-right:.35rem; color:#86efac; font-weight:800; }
    .template-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:1rem; margin-top:3rem; }
    .template-card { display:flex; flex-direction:column; min-height:285px; padding:1.4rem; border:1px solid var(--border); border-radius:14px; background:var(--bg-card); color:var(--text); text-decoration:none; transition:transform .15s,border-color .15s; }
    .template-card:hover { border-color:var(--accent); transform:translateY(-2px); }
    .template-card:focus-visible,.workflow-card:focus-visible { outline:3px solid var(--accent); outline-offset:3px; }
    .template-category { color:var(--accent); font-size:.76rem; font-weight:750; letter-spacing:.07em; text-transform:uppercase; }
    .template-card h2 { margin:.65rem 0 .6rem; font-size:1.25rem; line-height:1.25; }
    .template-card p { color:var(--text-dim); font-size:.92rem; line-height:1.68; }
    .template-meta { margin-top:auto; padding-top:1.2rem; color:var(--accent); font-size:.9rem; font-weight:700; }
    .workflow { margin-top:4rem; }
    .workflow > h2 { text-align:center; font-size:1.8rem; }
    .workflow > p { max-width:700px; margin:.7rem auto 1.4rem; color:var(--text-dim); text-align:center; line-height:1.75; }
    .workflow-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:1rem; }
    .workflow-card { padding:1.25rem; border:1px solid var(--border); border-radius:12px; background:rgba(30,41,59,.55); color:var(--text); text-decoration:none; }
    .workflow-card h3 { margin:.25rem 0 .55rem; font-size:1rem; }
    .workflow-card p { color:var(--text-dim); font-size:.9rem; line-height:1.65; }
    .workflow-card span { display:inline-block; margin-top:.9rem; color:var(--accent); font-size:.88rem; font-weight:700; }
    .learn { max-width:820px; margin:4rem auto 0; padding:1.3rem; border:1px solid var(--border); border-radius:14px; background:var(--bg-card); text-align:center; }
    .learn h2 { font-size:1.45rem; }
    .learn p { margin:.6rem 0 1rem; color:var(--text-dim); line-height:1.7; }
    .learn a { color:var(--accent); font-weight:700; }
    @media (max-width:860px) { .template-grid { grid-template-columns:repeat(2,minmax(0,1fr)); } }
    @media (max-width:620px) { .templates-page { width:min(100% - 1.5rem,1120px); padding-top:2rem; } .template-grid,.workflow-grid { grid-template-columns:1fr; } .template-card { min-height:0; } }
  </style>

  <main class="templates-page">
    <header class="templates-hero">
      <span class="eyebrow">Free, copy-ready starting points</span>
      <h1>Free Markdown templates for practical documentation</h1>
      <p>Start with a clear structure for a README, API reference, command guide, release note, technical brief, or comparison table. Open any template in the editor, adapt it to your project, and keep your text on your device.</p>
      <div class="trust-strip" aria-label="Template benefits">
        <span>No account required</span><span>Copy-ready Markdown</span><span>Built for GitHub and docs</span>
      </div>
    </header>

    <section class="template-grid" aria-label="Markdown templates">
      {MARKDOWN_TEMPLATES.map((template) => (
        <a class="template-card" href={`/templates/${template.slug}/`}>
          <span class="template-category">{template.category}</span>
          <h2>{template.title}</h2>
          <p>{template.description}</p>
          <span class="template-meta">Use this template &rarr;</span>
        </a>
      ))}
    </section>

    <section class="workflow" aria-labelledby="workflow-heading">
      <h2 id="workflow-heading">Choose a template, then finish the task</h2>
      <p>Templates give you a sound document structure. Continue with the right browser tool when you need to edit, generate a table, or create a project README.</p>
      <div class="workflow-grid">
        <a class="workflow-card" href="/editor/">
          <h3>Write and preview</h3>
          <p>Use the Markdown editor for a side-by-side writing and preview workflow.</p>
          <span>Open editor &rarr;</span>
        </a>
        <a class="workflow-card" href="/tools/markdown-table-generator/">
          <h3>Build a Markdown table</h3>
          <p>Create GitHub-ready tables for API fields, commands, and feature comparisons.</p>
          <span>Open table generator &rarr;</span>
        </a>
        <a class="workflow-card" href="/tools/readme-generator/">
          <h3>Start a project README</h3>
          <p>Generate a concise README scaffold when you need a quick repository overview.</p>
          <span>Open README generator &rarr;</span>
        </a>
      </div>
    </section>

    <section class="learn" aria-labelledby="learn-heading">
      <h2 id="learn-heading">Need the Markdown syntax behind the template?</h2>
      <p>Learn how headings, lists, tables, code blocks, and links work before tailoring your document.</p>
      <a href="/blog/markdown-syntax-complete-guide/">Read the complete Markdown syntax guide &rarr;</a>
    </section>
  </main>
</BaseLayout>
